@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Kota Permai Golf &amp; Country Club</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark__leaf" aria-hidden="true"></span>
                    Kota Permai
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-controller="Facilities" asp-action="Index">Facilities</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Membership" asp-action="Plans">Membership</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole(AppRoles.Member) || User.IsInRole(AppRoles.Administrator))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Member" asp-action="Dashboard">My Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Membership" asp-action="Manage">Membership</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Guests" asp-action="Index">Guests</a></li>
                            }
                            @if (User.IsInRole(AppRoles.Staff) || User.IsInRole(AppRoles.Administrator))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Staff" asp-action="Index">Staff</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Staff" asp-action="CheckIn">Staff operations &amp; check-in</a></li>
                            }
                            @if (User.IsInRole(AppRoles.Administrator))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin governance</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports &amp; analytics</a></li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <span class="nav-user">@User.Identity?.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Join</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="container mt-3"><div class="alert alert-success flash">@success</div></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="container mt-3"><div class="alert alert-danger flash">@error</div></div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <strong class="brand-mark">Kota Permai Golf &amp; Country Club</strong>
                <p class="mb-0 mt-2">Reserve sports courts, pools, gym, driving range and banquet rooms online — Kota Kemuning, Shah Alam.</p>
            </div>
            <div>
                <p class="mb-1">MYR payments · English · PDPA notice on registration</p>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
