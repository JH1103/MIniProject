@{
    ViewData["Title"] = "Staff operations & check-in";
    var tab = (ViewBag.SelectedTab as string) ?? "clearance";
    var todaySlots = (int)(ViewBag.TodaySlots ?? 0);
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var pending = ViewBag.PendingApprovals as List<Booking> ?? new();
    var today = ViewBag.TodayBookings as List<Booking> ?? new();
    var insideGuests = ViewBag.InsideGuests as List<CheckInRecord> ?? new();
    var insideMembers = ViewBag.InsideMembers as List<MemberCheckIn> ?? new();
    var demoPasses = ViewBag.DemoPasses as List<VisitorPass> ?? new();
    var lastGuest = ViewBag.LastGuestPass as VisitorPass;
    var lastMember = ViewBag.LastMember as ApplicationUser;
    var staffName = User.Identity?.Name ?? "Staff";
}

<section class="section staff-ops">
    <div class="container">
        <div class="admin-hero staff-hero">
            <div class="admin-hero__copy">
                <div class="admin-hero__eyebrow">Module 4 · Clubhouse front desk &amp; security clearance</div>
                <span class="badge-soft">Staff operations &amp; check-in</span>
                <h1>Clubhouse Front Desk &amp; Security Clearance</h1>
                <p class="mb-0">Signed in as @staffName · scan guest passes or member digital cards in under 30 seconds.</p>
            </div>
            <div class="admin-hero__stats">
                <div>
                    <span>Today's slots</span>
                    <strong>@todaySlots</strong>
                </div>
                <div>
                    <span>Pending review</span>
                    <strong>@pendingCount</strong>
                </div>
            </div>
        </div>

        <nav class="admin-tabs" aria-label="Staff check-in sections">
            <a class="@(tab == "clearance" ? "is-active" : null)" asp-action="CheckIn" asp-route-tab="clearance">Visitor QR clearance desk</a>
            <a class="@(tab == "approvals" ? "is-active" : null)" asp-action="CheckIn" asp-route-tab="approvals">Pending facility approvals <span>@pendingCount</span></a>
            <a class="@(tab == "timeline" ? "is-active" : null)" asp-action="CheckIn" asp-route-tab="timeline">Today's clubhouse timeline</a>
        </nav>

        @if (tab == "clearance")
        {
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="panel checkin-scanner">
                        <h3 class="h5">QR scanner terminal</h3>
                        <div class="scanner-frame" aria-hidden="true">
                            <div class="scanner-frame__inner">
                                <svg viewBox="0 0 64 64" width="64" height="64" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M10 22V14h8M46 14h8v8M54 42v8h-8M18 50H10v-8"/>
                                    <rect x="20" y="20" width="10" height="10"/>
                                    <rect x="34" y="20" width="10" height="10"/>
                                    <rect x="20" y="34" width="10" height="10"/>
                                    <path d="M34 34h4v4h-4zm6 0h4v10H34v-6h6z"/>
                                </svg>
                                <p>Align guest QR or member digital card within frame. Completes check-in in under 30 seconds.</p>
                            </div>
                        </div>

                        <form asp-action="CheckIn" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tab" value="clearance" />
                            <label class="form-label">Or enter digital pass code / member QR</label>
                            <div class="d-flex flex-wrap gap-2">
                                <input class="form-control" name="passCode" placeholder="GC-… or MEM-…" required style="flex:1;min-width:180px" />
                                <button class="btn btn-primary" name="actionType" value="in" type="submit">Clear pass</button>
                                <button class="btn btn-ghost" name="actionType" value="out" type="submit">Check out</button>
                            </div>
                        </form>

                        @if (demoPasses.Any())
                        {
                            <div class="mt-4">
                                <div class="small text-uppercase muted fw-semibold mb-2">Simulate 1-click scan</div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var demo in demoPasses)
                                    {
                                        <form asp-action="CheckIn" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tab" value="clearance" />
                                            <input type="hidden" name="passCode" value="@demo.PassCode" />
                                            <button class="btn btn-sm btn-ghost" name="actionType" value="in" type="submit">
                                                @demo.PassCode (@demo.Guest?.FullName)
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }

                        @if (lastGuest is not null || lastMember is not null)
                        {
                            <div class="mt-3 panel" style="box-shadow:none;background:rgba(47,122,109,0.08)">
                                <div class="small text-uppercase muted fw-semibold">Last scan</div>
                                @if (lastMember is not null)
                                {
                                    <strong>@lastMember.FullName</strong>
                                    <div class="small muted">Member card · @ViewBag.LastMemberPlan</div>
                                }
                                else if (lastGuest is not null)
                                {
                                    <strong>@lastGuest.Guest?.FullName</strong>
                                    <div class="small muted">@lastGuest.PassCode · @lastGuest.Booking?.Facility?.Name</div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="panel">
                        <h3 class="h5 mb-1">Registered clearance ledger</h3>
                        <p class="muted small">People currently inside the clubhouse (PDPA audited).</p>

                        <div class="small text-uppercase muted fw-semibold mb-2">Members inside (@insideMembers.Count)</div>
                        @if (!insideMembers.Any())
                        {
                            <p class="muted small">No members checked in.</p>
                        }
                        else
                        {
                            <div class="table-responsive mb-3">
                                <table class="table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Pass code</th>
                                            <th>Member</th>
                                            <th>Since</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var row in insideMembers)
                                    {
                                        var code = MemberPassHelper.BuildPassCode(row.MemberId);
                                        <tr>
                                            <td><code>@code</code></td>
                                            <td>@row.Member?.FullName</td>
                                            <td>@row.CheckedInAt.ToLocalTime().ToString("HH:mm")</td>
                                            <td><span class="badge-soft">Inside clubhouse</span></td>
                                            <td>
                                                <form asp-action="CheckIn" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="tab" value="clearance" />
                                                    <input type="hidden" name="passCode" value="@code" />
                                                    <button class="btn btn-sm btn-ghost" name="actionType" value="out" type="submit">Check out</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="small text-uppercase muted fw-semibold mb-2">Guest passes inside (@insideGuests.Count)</div>
                        @if (!insideGuests.Any())
                        {
                            <p class="muted mb-0">No guest passes checked in.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Pass code</th>
                                            <th>Guest</th>
                                            <th>Host &amp; facility</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var row in insideGuests)
                                    {
                                        <tr>
                                            <td><code>@row.VisitorPass?.PassCode</code></td>
                                            <td>
                                                @row.VisitorPass?.Guest?.FullName
                                                <div class="small muted">@row.VisitorPass?.Guest?.IdentificationNumber</div>
                                            </td>
                                            <td>
                                                @row.VisitorPass?.Booking?.Facility?.Name
                                                <div class="small muted">Host booking #@row.VisitorPass?.BookingId</div>
                                            </td>
                                            <td><span class="badge-soft">Inside clubhouse</span></td>
                                            <td>
                                                <form asp-action="CheckIn" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="tab" value="clearance" />
                                                    <input type="hidden" name="passCode" value="@row.VisitorPass?.PassCode" />
                                                    <button class="btn btn-sm btn-ghost" name="actionType" value="out" type="submit">Check out</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (tab == "approvals")
        {
            <div class="panel">
                <h3 class="h5">Pending special facility approvals</h3>
                @if (!pending.Any())
                {
                    <p class="muted mb-0">No bookings awaiting staff approval.</p>
                }
                else
                {
                    @foreach (var booking in pending)
                    {
                        <div class="d-flex justify-content-between align-items-center gap-2 py-2 border-bottom">
                            <div>
                                <strong>@booking.Facility?.Name</strong>
                                <div class="small muted">@booking.Member?.FullName · @booking.StartUtc.ToLocalTime().ToString("dd MMM HH:mm")</div>
                            </div>
                            <form asp-action="Approve" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@booking.Id" />
                                <button class="btn btn-sm btn-primary" type="submit">Approve</button>
                            </form>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="panel">
                <h3 class="h5">Today's clubhouse timeline</h3>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>Time</th><th>Facility</th><th>Member</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var booking in today)
                        {
                            <tr>
                                <td>@booking.StartUtc.ToLocalTime().ToString("HH:mm")</td>
                                <td>@booking.Facility?.Name</td>
                                <td>@booking.Member?.FullName</td>
                                <td>@booking.Status</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>
