@using MIniProject.ViewModels
@{
    ViewData["Title"] = "Staff operations & check-in";
    var tab = (ViewBag.SelectedTab as string) ?? "clearance";
    var todaySlots = (int)(ViewBag.TodaySlots ?? 0);
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var pending = ViewBag.PendingApprovals as List<Booking> ?? new();
    var today = ViewBag.TodayBookings as List<Booking> ?? new();
    var insideGuests = ViewBag.InsideGuests as List<CheckInRecord> ?? new();
    var insideMembers = ViewBag.InsideMembers as List<MemberCheckIn> ?? new();
    var demoPasses = ViewBag.DemoPasses as List<VisitorPass> ?? new();
    var lastGuest = ViewBag.LastGuestPass as VisitorPass;
    var lastMember = ViewBag.LastMember as ApplicationUser;
    var preview = ViewBag.ScanPreview as CheckInPreviewViewModel;
    var staffName = User.Identity?.Name ?? "Staff";
}

<section class="section staff-ops">
    <div class="container">
        <div class="admin-hero staff-hero">
            <div class="admin-hero__copy">
                <div class="admin-hero__eyebrow">Module 4 · Clubhouse front desk &amp; security clearance</div>
                <span class="badge-soft">Staff operations &amp; check-in</span>
                <h1>Clubhouse Front Desk &amp; Security Clearance</h1>
                <p class="mb-0">Signed in as @staffName · scan QR to review booking details, then confirm check-in manually.</p>
            </div>
            <div class="admin-hero__stats">
                <div>
                    <span>Today's slots</span>
                    <strong>@todaySlots</strong>
                </div>
                <div>
                    <span>Pending review</span>
                    <strong>@pendingCount</strong>
                </div>
            </div>
        </div>

        <nav class="admin-tabs" aria-label="Staff check-in sections">
            <a class="@(tab == "clearance" ? "is-active" : null)" asp-action="CheckIn" asp-route-tab="clearance">Visitor QR clearance desk</a>
            <a class="@(tab == "approvals" ? "is-active" : null)" asp-action="CheckIn" asp-route-tab="approvals">Pending facility approvals <span>@pendingCount</span></a>
            <a class="@(tab == "timeline" ? "is-active" : null)" asp-action="CheckIn" asp-route-tab="timeline">Today's clubhouse timeline</a>
        </nav>

        @if (tab == "clearance")
        {
            <div class="row g-4 clearance-desk">
                <div class="col-xl-4 col-lg-5">
                    <div class="panel checkin-scanner">
                        <h3 class="h5">QR scanner terminal</h3>
                        <div class="scanner-frame">
                            <div class="scanner-frame__inner scanner-frame__inner--live">
                                <div id="qrReader" class="qr-reader" aria-label="Webcam QR scanner"></div>
                                <p id="qrScannerStatus" class="scanner-status">Starting camera… Align guest QR or member digital card within the frame.</p>
                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    <button type="button" class="btn btn-sm btn-primary" id="qrStartBtn">Start camera</button>
                                    <button type="button" class="btn btn-sm btn-ghost" id="qrStopBtn" hidden>Stop camera</button>
                                </div>
                            </div>
                        </div>

                        <form asp-action="CheckIn" method="post" class="mt-3" id="checkInForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tab" value="clearance" />
                            <label class="form-label">Or enter digital pass code / member QR</label>
                            <div class="d-flex flex-wrap gap-2">
                                <input class="form-control" name="passCode" id="passCodeInput" placeholder="GC-… or MEM-…" required style="flex:1;min-width:180px" autocomplete="off" value="@(preview?.PassCode ?? string.Empty)" />
                                <button class="btn btn-primary" name="actionType" value="lookup" type="submit" id="lookupSubmit">Look up</button>
                                <button class="btn btn-ghost" name="actionType" value="out" type="submit">Check out</button>
                            </div>
                            <p class="small muted mt-2 mb-0">Scan or look up first. Check-in opens 15 minutes before the booking start.</p>
                        </form>

                        @if (demoPasses.Any())
                        {
                            <div class="mt-4">
                                <div class="small text-uppercase muted fw-semibold mb-2">Simulate look-up scan</div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var demo in demoPasses)
                                    {
                                        <form asp-action="CheckIn" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tab" value="clearance" />
                                            <input type="hidden" name="passCode" value="@demo.PassCode" />
                                            <button class="btn btn-sm btn-ghost" name="actionType" value="lookup" type="submit">
                                                @demo.PassCode (@demo.Guest?.FullName)
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }

                        @if (preview is not null)
                        {
                            <div class="mt-3 panel" style="box-shadow:none;background:rgba(47,122,109,0.08)" id="scanPreviewPanel">
                                <div class="small text-uppercase muted fw-semibold">Scanned details</div>
                                <strong>@preview.DisplayName</strong>
                                <div class="small muted">
                                    @(preview.IsMember ? $"Member card · {preview.PlanName}" : $"Guest pass · {preview.PassCode}")
                                    @if (!string.IsNullOrWhiteSpace(preview.Identification))
                                    {
                                        <span> · @preview.Identification</span>
                                    }
                                </div>

                                <div class="mt-3">
                                    <div class="small text-uppercase muted fw-semibold mb-1">Today's booking(s)</div>
                                    @if (preview.TodayBookings.Any())
                                    {
                                        <ul class="mb-2 ps-3">
                                            @foreach (var booking in preview.TodayBookings)
                                            {
                                                <li class="mb-1">
                                                    <strong>@booking.FacilityName</strong>
                                                    · @booking.StartUtc.ToLocalTime().ToString("HH:mm")–@booking.EndUtc.ToLocalTime().ToString("HH:mm")
                                                    · @booking.Status
                                                    @if (booking.IsEligibleWindow)
                                                    {
                                                        <span class="badge-soft">Ready to check in</span>
                                                    }
                                                    else if (DateTime.UtcNow < booking.CheckInOpensUtc)
                                                    {
                                                        <span class="badge-warn">Opens @booking.CheckInOpensUtc.ToLocalTime().ToString("HH:mm")</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(preview.PromptMessage))
                                {
                                    <div class="alert alert-warning py-2 px-3 mb-0">@preview.PromptMessage</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(preview.BlockReason))
                                {
                                    <div class="alert alert-danger py-2 px-3 mb-0">@preview.BlockReason</div>
                                }

                                @if (preview.CanCheckIn)
                                {
                                    <form asp-action="CheckIn" method="post" class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tab" value="clearance" />
                                        <input type="hidden" name="passCode" value="@preview.PassCode" />
                                        @if (preview.SelectedBookingId is not null)
                                        {
                                            <input type="hidden" name="bookingId" value="@preview.SelectedBookingId" />
                                        }
                                        <button class="btn btn-primary" name="actionType" value="in" type="submit">
                                            Confirm check-in
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                        else if (lastGuest is not null || lastMember is not null)
                        {
                            <div class="mt-3 panel" style="box-shadow:none;background:rgba(47,122,109,0.08)">
                                <div class="small text-uppercase muted fw-semibold">Last scan</div>
                                @if (lastMember is not null)
                                {
                                    <strong>@lastMember.FullName</strong>
                                    <div class="small muted">Member card · @ViewBag.LastMemberPlan</div>
                                }
                                else if (lastGuest is not null)
                                {
                                    <strong>@lastGuest.Guest?.FullName</strong>
                                    <div class="small muted">@lastGuest.PassCode · @lastGuest.Booking?.Facility?.Name</div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="col-xl-8 col-lg-7">
                    <div class="panel clearance-ledger">
                        <h3 class="h5 mb-1">Registered clearance ledger</h3>
                        <p class="muted small">People currently inside the clubhouse — facility in use and clearance status (PDPA audited).</p>

                        <div class="small text-uppercase muted fw-semibold mb-2">Members inside (@insideMembers.Count)</div>
                        @if (!insideMembers.Any())
                        {
                            <p class="muted small">No members checked in.</p>
                        }
                        else
                        {
                            <div class="table-responsive mb-3">
                                <table class="table clearance-ledger__table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Member</th>
                                            <th>Facility</th>
                                            <th>Since</th>
                                            <th>Status</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var row in insideMembers)
                                    {
                                        var code = MemberPassHelper.BuildPassCode(row.MemberId);
                                        var facilityName = row.Facility?.Name
                                            ?? row.Booking?.Facility?.Name
                                            ?? "—";
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@row.Member?.FullName</div>
                                                <code class="pass-code" title="@code">@code</code>
                                            </td>
                                            <td>@facilityName</td>
                                            <td>@row.CheckedInAt.ToLocalTime().ToString("HH:mm")</td>
                                            <td>
                                                @if (row.Status == ClearanceStatus.UsingFacility)
                                                {
                                                    <span class="badge-warn">Using facility</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-soft">Checked in</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <form asp-action="CheckIn" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="tab" value="clearance" />
                                                    <input type="hidden" name="passCode" value="@code" />
                                                    <button class="btn btn-sm btn-ghost" name="actionType" value="out" type="submit">Check out</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="small text-uppercase muted fw-semibold mb-2">Guest passes inside (@insideGuests.Count)</div>
                        @if (!insideGuests.Any())
                        {
                            <p class="muted mb-0">No guest passes checked in.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table clearance-ledger__table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Guest</th>
                                            <th>Facility</th>
                                            <th>Status</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var row in insideGuests)
                                    {
                                        var facilityName = row.VisitorPass?.Booking?.Facility?.Name ?? "—";
                                        var passCode = row.VisitorPass?.PassCode ?? string.Empty;
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@row.VisitorPass?.Guest?.FullName</div>
                                                <code class="pass-code" title="@passCode">@passCode</code>
                                                @if (!string.IsNullOrWhiteSpace(row.VisitorPass?.Guest?.IdentificationNumber))
                                                {
                                                    <div class="small muted">@row.VisitorPass?.Guest?.IdentificationNumber</div>
                                                }
                                            </td>
                                            <td>
                                                @facilityName
                                                <div class="small muted">Host booking #@row.VisitorPass?.BookingId</div>
                                            </td>
                                            <td>
                                                @if (row.Status == ClearanceStatus.UsingFacility)
                                                {
                                                    <span class="badge-warn">Using facility</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-soft">Checked in</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <form asp-action="CheckIn" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="tab" value="clearance" />
                                                    <input type="hidden" name="passCode" value="@passCode" />
                                                    <button class="btn btn-sm btn-ghost" name="actionType" value="out" type="submit">Check out</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (tab == "approvals")
        {
            <div class="panel">
                <h3 class="h5">Pending special facility approvals</h3>
                @if (!pending.Any())
                {
                    <p class="muted mb-0">No bookings awaiting staff approval.</p>
                }
                else
                {
                    @foreach (var booking in pending)
                    {
                        <div class="d-flex justify-content-between align-items-center gap-2 py-2 border-bottom">
                            <div>
                                <strong>@booking.Facility?.Name</strong>
                                <div class="small muted">@booking.Member?.FullName · @booking.StartUtc.ToLocalTime().ToString("dd MMM HH:mm")</div>
                            </div>
                            <form asp-action="Approve" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@booking.Id" />
                                <button class="btn btn-sm btn-primary" type="submit">Approve</button>
                            </form>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="panel">
                <h3 class="h5">Today's clubhouse timeline</h3>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>Time</th><th>Facility</th><th>Member</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var booking in today)
                        {
                            <tr>
                                <td>@booking.StartUtc.ToLocalTime().ToString("HH:mm")</td>
                                <td>@booking.Facility?.Name</td>
                                <td>@booking.Member?.FullName</td>
                                <td>@booking.Status</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
(() => {
  const statusEl = document.getElementById('qrScannerStatus');
  const startBtn = document.getElementById('qrStartBtn');
  const stopBtn = document.getElementById('qrStopBtn');
  const passInput = document.getElementById('passCodeInput');
  const form = document.getElementById('checkInForm');
  if (!statusEl || !startBtn || !passInput || !form || typeof Html5Qrcode === 'undefined') {
    if (statusEl) statusEl.textContent = 'Camera scanner unavailable. Use manual pass code entry below.';
    return;
  }

  const reader = new Html5Qrcode('qrReader');
  let running = false;
  let submitting = false;

  const setStatus = (text) => { statusEl.textContent = text; };

  const onScanSuccess = async (decodedText) => {
    const code = (decodedText || '').trim();
    if (!code || submitting) return;
    submitting = true;
    passInput.value = code;
    setStatus(`Scanned ${code}. Looking up booking details…`);
    try { await stopCamera(); } catch { /* ignore */ }
    form.requestSubmit(document.getElementById('lookupSubmit'));
  };

  const startCamera = async () => {
    if (running) return;
    setStatus('Requesting camera permission…');
    try {
      await reader.start(
        { facingMode: 'environment' },
        { fps: 10, qrbox: { width: 220, height: 220 } },
        onScanSuccess,
        () => {}
      );
      running = true;
      startBtn.hidden = true;
      stopBtn.hidden = false;
      setStatus('Camera ready. Align guest QR or member digital card within the frame.');
    } catch (err) {
      console.error(err);
      try {
        await reader.start(
          { facingMode: 'user' },
          { fps: 10, qrbox: { width: 220, height: 220 } },
          onScanSuccess,
          () => {}
        );
        running = true;
        startBtn.hidden = true;
        stopBtn.hidden = false;
        setStatus('Camera ready. Align guest QR or member digital card within the frame.');
      } catch (fallbackErr) {
        console.error(fallbackErr);
        setStatus('Camera access denied or unavailable. Allow camera permission, or enter the pass code manually.');
        startBtn.hidden = false;
        stopBtn.hidden = true;
      }
    }
  };

  const stopCamera = async () => {
    if (!running) return;
    await reader.stop();
    running = false;
    startBtn.hidden = false;
    stopBtn.hidden = true;
    setStatus('Camera stopped. Press Start camera to scan again, or enter a pass code manually.');
  };

  startBtn.addEventListener('click', startCamera);
  stopBtn.addEventListener('click', () => stopCamera().catch(() => {}));
  startCamera();
})();
</script>
}
