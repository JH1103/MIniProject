@model EquipmentRental
@using MIniProject.Services
@{
    ViewData["Title"] = $"Rental #{Model.Id}";
    var isStaff = User.IsInRole(AppRoles.Staff) || User.IsInRole(AppRoles.Administrator);
    var statusLabel = EquipmentRentalLifecycle.DisplayLabel(Model.Status);
    var canEdit = Model.Status is EquipmentRentalStatus.Active
        or EquipmentRentalStatus.Rented
        or EquipmentRentalStatus.NotReturned
        or EquipmentRentalStatus.Invalid;
    var canDelete = Model.Status is EquipmentRentalStatus.Invalid
        or EquipmentRentalStatus.Cancelled
        or EquipmentRentalStatus.Inactive
        || (isStaff && Model.Status == EquipmentRentalStatus.Returned);
    var canCancel = EquipmentRentalLifecycle.CanCancel(Model.Status);
    var unpaidInvoiceId = ViewBag.UnpaidInvoiceId as int?;
    var pickupBlockedUnpaid = ViewBag.PickupBlockedUnpaid is true;
}

<section class="section">
    <div class="container" style="max-width:720px">
        <div class="section-head">
            <h2>Equipment rental #@Model.Id</h2>
            <p class="muted mb-0">@Model.InventoryItem?.Name · @statusLabel</p>
        </div>
        <div class="panel">
            <div class="row g-3">
                <div class="col-md-6"><strong>Member</strong><div>@Model.Member?.FullName</div></div>
                <div class="col-md-6"><strong>Facility</strong><div>@Model.InventoryItem?.Facility?.Name</div></div>
                <div class="col-md-6"><strong>Equipment</strong><div>@Model.InventoryItem?.Name × @Model.Quantity</div></div>
                <div class="col-md-6"><strong>Fee</strong><div>MYR @Model.Fee.ToString("N2") <span class="small muted">(MYR @EquipmentPricing.FeePerUnitPerDay.ToString("N0")/unit/day)</span></div></div>
                <div class="col-md-6"><strong>Start</strong><div>@Model.StartUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div></div>
                <div class="col-md-6"><strong>Due</strong><div>@Model.DueUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div></div>
                <div class="col-md-6"><strong>Status</strong><div><span class="badge-soft">@statusLabel</span></div></div>
                <div class="col-md-6"><strong>Picked up</strong><div>@(Model.PickedUpAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</div></div>
                <div class="col-md-6"><strong>Returned</strong><div>@(Model.ReturnedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</div></div>
                <div class="col-md-6"><strong>Booking</strong><div>@(Model.BookingId is null ? "—" : $"#{Model.BookingId}")</div></div>
                <div class="col-12"><strong>Notes</strong><div>@(Model.Notes ?? "—")</div></div>
            </div>

            @if (pickupBlockedUnpaid && Model.Status == EquipmentRentalStatus.Active)
            {
                <div class="alert alert-warning mt-3 mb-0" role="status">
                    @if (unpaidInvoiceId is int payId)
                    {
                        <text>Payment is outstanding for this equipment rental. Pickup cannot be confirmed until the member pays.</text>
                        <a class="alert-link" asp-controller="Payments" asp-action="Pay" asp-route-id="@payId">Pay invoice now</a>
                    }
                    else
                    {
                        <text>The member has not paid for this equipment rental. Pickup cannot be confirmed until payment is completed.</text>
                    }
                </div>
            }

            <div class="mt-4 d-flex flex-wrap gap-2">
                @if (unpaidInvoiceId is int payInvoiceId && Model.Status == EquipmentRentalStatus.Active)
                {
                    <a class="btn btn-primary" asp-controller="Payments" asp-action="Pay" asp-route-id="@payInvoiceId">Pay now</a>
                }
                @if (canCancel)
                {
                    <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this equipment rental? Stock will be restored@(Model.Fee > 0 ? " and unpaid charges adjusted" : "").');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-ghost" type="submit">Cancel rental</button>
                    </form>
                }
                @if (canEdit)
                {
                    <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@Model.Id">Update rental</a>
                }
                @if (isStaff && EquipmentRentalLifecycle.CanMarkPickedUp(Model.Status))
                {
                    @if (pickupBlockedUnpaid)
                    {
                        <button class="btn btn-primary" type="button" disabled title="Member has not paid for this equipment rental.">Confirm taken / pickup</button>
                        <p class="text-danger mb-0 align-self-center">Unpaid — pickup blocked until the member pays.</p>
                    }
                    else
                    {
                        <form asp-action="MarkPickedUp" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="btn btn-primary" type="submit">Confirm taken / pickup</button>
                        </form>
                    }
                }
                @if (EquipmentRentalLifecycle.CanMarkReturned(Model.Status))
                {
                    <form asp-action="Return" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-primary" type="submit">
                            @(Model.Status == EquipmentRentalStatus.NotReturned ? "Mark returned (was overdue)" : "Mark returned")
                        </button>
                    </form>
                }
                else if (Model.Status == EquipmentRentalStatus.Active)
                {
                    <p class="muted mb-0 align-self-center">Return is available after staff confirm pickup (Rented).</p>
                }
                @if (isStaff && Model.Status is EquipmentRentalStatus.Active
                    or EquipmentRentalStatus.Rented
                    or EquipmentRentalStatus.NotReturned)
                {
                    <form asp-action="MarkInvalid" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-ghost" type="submit">Mark invalid</button>
                    </form>
                }
                @if (canDelete || Model.Status == EquipmentRentalStatus.Invalid)
                {
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this invalid/cancelled rental record?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-ghost admin-danger" type="submit">Delete record</button>
                    </form>
                }
                <a class="btn btn-ghost" asp-action="Index">Back to list</a>
                @if (User.IsInRole(AppRoles.Member))
                {
                    <a class="btn btn-primary" asp-controller="Member" asp-action="Dashboard">My Dashboard</a>
                }
            </div>
        </div>
    </div>
</section>
