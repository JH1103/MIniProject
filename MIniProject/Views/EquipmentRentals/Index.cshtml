@model List<EquipmentRental>
@{
    ViewData["Title"] = "Equipment rentals";
    var isStaff = User.IsInRole(AppRoles.Staff) || User.IsInRole(AppRoles.Administrator);
    var isMember = User.IsInRole(AppRoles.Member);
    var canCreateRental = isMember && ViewBag.CanCreateRental is true;
}

<section class="section">
    <div class="container">
        <div class="section-head d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <h2>Equipment rentals</h2>
                <p class="muted mb-0">
                    @(isStaff
                        ? "Confirm member pickup, track rented gear, and resolve returns."
                        : "Rent facility equipment linked to your booking. Staff confirm pickup before returns.")
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (isMember)
                {
                    <a class="btn btn-ghost" asp-controller="Member" asp-action="Dashboard">My Dashboard</a>
                    @if (canCreateRental)
                    {
                        <a class="btn btn-primary" asp-action="Create">+ New rental</a>
                    }
                    else
                    {
                        <a class="btn btn-primary" asp-controller="Facilities" asp-action="Index">Book a facility first</a>
                    }
                }
            </div>
        </div>
        @if (isMember && !canCreateRental)
        {
            <div class="alert alert-warning" role="status">
                You are not allowed to have any equipment rental.
                <a asp-controller="Facilities" asp-action="Index" class="alert-link">Book a facility</a>
                first, then return here to create a rental linked to that booking.
            </div>
        }

        <div class="panel">
            @if (!Model.Any())
            {
                <p class="muted mb-0">No equipment rentals yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                @if (isStaff) { <th>Member</th> }
                                <th>Equipment</th>
                                <th>Qty</th>
                                <th>Window</th>
                                <th>Fee</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var rental in Model)
                        {
                            <tr>
                                <td>@rental.Id</td>
                                @if (isStaff)
                                {
                                    <td>@rental.Member?.FullName</td>
                                }
                                <td>
                                    @rental.InventoryItem?.Name
                                    <div class="small muted">@rental.InventoryItem?.Facility?.Name</div>
                                </td>
                                <td>@rental.Quantity</td>
                                <td>
                                    @rental.StartUtc.ToLocalTime().ToString("dd MMM HH:mm")
                                    –
                                    @rental.DueUtc.ToLocalTime().ToString("dd MMM HH:mm")
                                </td>
                                <td>MYR @rental.Fee.ToString("N2")</td>
                                <td>
                                    @{
                                        var statusLabel = EquipmentRentalLifecycle.DisplayLabel(rental.Status);
                                        var statusClass = rental.Status is EquipmentRentalStatus.Rented
                                            or EquipmentRentalStatus.Active
                                            ? "badge-soft"
                                            : "badge-warn";
                                    }
                                    <span class="@statusClass">@statusLabel</span>
                                </td>
                                <td class="text-nowrap">
                                    <a asp-action="Details" asp-route-id="@rental.Id">View</a>
                                    @if (EquipmentRentalLifecycle.CanCancel(rental.Status))
                                    {
                                        <text> · </text>
                                        <form asp-action="Cancel" method="post" class="d-inline" onsubmit="return confirm('Cancel this awaiting-pickup rental?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@rental.Id" />
                                            <button class="btn btn-link p-0 align-baseline" type="submit">Cancel</button>
                                        </form>
                                    }
                                    @if (isStaff && EquipmentRentalLifecycle.CanMarkPickedUp(rental.Status))
                                    {
                                        <text> · </text>
                                        <form asp-action="MarkPickedUp" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@rental.Id" />
                                            <button class="btn btn-link p-0 align-baseline" type="submit">Mark taken</button>
                                        </form>
                                    }
                                    @if (EquipmentRentalLifecycle.CanMarkReturned(rental.Status))
                                    {
                                        <text> · </text>
                                        <form asp-action="Return" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@rental.Id" />
                                            <button class="btn btn-link p-0 align-baseline" type="submit">Mark returned</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>
