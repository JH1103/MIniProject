@model PaymentMethodViewModel
@{
    ViewData["Title"] = "Payment";
    var invoice = Model.Invoice;
}

<section class="section">
    <div class="container" style="max-width:760px">
        <div class="section-head">
            <h2>Complete payment</h2>
            <p class="muted mb-0">Choose card or e-wallet. Card details are used only to process this payment and are not stored.</p>
        </div>
        <div class="panel mb-3">
            <div class="row g-3">
                <div class="col-md-6"><strong>Invoice</strong><div>@invoice.InvoiceNumber</div></div>
                <div class="col-md-6"><strong>Amount</strong><div>MYR @invoice.Amount.ToString("0.00")</div></div>
                <div class="col-12"><strong>Description</strong><div>@invoice.Description</div></div>
                @if (invoice.Booking?.Facility is not null)
                {
                    <div class="col-12 muted">@invoice.Booking.Facility.Name · @invoice.Booking.StartUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                }
            </div>
        </div>

        @if (invoice.Status == InvoiceStatus.Unpaid || invoice.Status == InvoiceStatus.Overdue)
        {
            <div class="payment-method-grid">
                <a class="payment-method-card" asp-action="PayCard" asp-route-id="@invoice.Id">
                    <span class="payment-method-card__icon payment-method-card__icon--card" aria-hidden="true"></span>
                    <h3 class="h5 mb-1">Pay by card</h3>
                    <p class="muted mb-0">Enter card number, expiry date and CVV to pay.</p>
                </a>
                <a class="payment-method-card" asp-action="PayEWallet" asp-route-id="@invoice.Id">
                    <span class="payment-method-card__icon payment-method-card__icon--wallet" aria-hidden="true"></span>
                    <h3 class="h5 mb-1">Pay by e-wallet</h3>
                    <p class="muted mb-0">Scan the QR code with your e-wallet app to pay.</p>
                </a>
            </div>
        }
        else
        {
            <a class="btn btn-primary" asp-action="Receipt" asp-route-id="@invoice.Id">View receipt</a>
        }
    </div>
</section>
