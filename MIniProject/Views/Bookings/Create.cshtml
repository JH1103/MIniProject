@model BookingCreateViewModel
@{
    ViewData["Title"] = "Book facility";
    var initial = Model.FacilityName?.Trim();
    var initialLetter = string.IsNullOrEmpty(initial) ? "F" : initial[0].ToString().ToUpperInvariant();
}

<section class="section booking-modal-page">
    <div class="container" style="max-width:820px">
        <div class="booking-modal panel p-0 overflow-hidden">
            <div class="booking-modal__header">
                <div class="booking-modal__identity">
                    <span class="booking-modal__avatar" aria-hidden="true">@initialLetter</span>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <h2 class="h4 mb-0 text-white">@Model.FacilityName</h2>
                            @if (Model.BookingMode == BookingMode.ApprovalRequired)
                            {
                                <span class="badge-soft booking-modal__badge">Requires Approval</span>
                            }
                            else
                            {
                                <span class="badge-soft booking-modal__badge">Instant confirmation</span>
                            }
                        </div>
                        <p class="mb-0 booking-modal__sub">
                            Reserving as: <strong>@Model.MemberDisplayName</strong>
                            @if (!string.IsNullOrWhiteSpace(Model.MembershipPlanName))
                            {
                                <span>(@Model.MembershipPlanName Member)</span>
                            }
                        </p>
                    </div>
                </div>
                <a class="booking-modal__close" asp-controller="Facilities" asp-action="Details" asp-route-id="@Model.FacilityId" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" aria-label="Close">×</a>
            </div>

            <nav class="booking-steps" aria-label="Booking steps">
                <button type="button" class="booking-steps__item is-active" data-step-tab="1">1. Date &amp; Time</button>
                <span aria-hidden="true">›</span>
                <button type="button" class="booking-steps__item" data-step-tab="2">2. Equipment</button>
                <span aria-hidden="true">›</span>
                <button type="button" class="booking-steps__item" data-step-tab="3">3. Guests</button>
                <span aria-hidden="true">›</span>
                <button type="button" class="booking-steps__item" data-step-tab="4">4. Review &amp; Pay</button>
            </nav>

            <form asp-action="Create" method="post" id="bookingWizardForm" class="booking-modal__body">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FacilityId" />
                <input type="hidden" asp-for="FacilityName" />
                <input type="hidden" asp-for="FacilityImageUrl" />
                <input type="hidden" asp-for="BookingMode" />
                <input type="hidden" asp-for="HourlyRate" />
                <input type="hidden" asp-for="MaxGuests" />
                <input type="hidden" asp-for="MemberDisplayName" />
                <input type="hidden" asp-for="MembershipPlanName" />
                <input type="hidden" asp-for="DiscountPercent" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="booking-step is-active" data-step="1">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Date" class="form-label text-uppercase small muted">Reservation date</label>
                            <input asp-for="Date" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-uppercase small muted">Start time</label>
                            <select asp-for="SlotStart" class="form-select" id="slotStartSelect">
                                <option value="">Select</option>
                                @foreach (var slot in Model.AvailableSlots.Where(s => s.Available))
                                {
                                    <option value="@slot.Start">@slot.Start</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-uppercase small muted">End time</label>
                            <select asp-for="SlotEnd" class="form-select" id="slotEndSelect">
                                <option value="">Select</option>
                                @foreach (var slot in Model.AvailableSlots.Where(s => s.Available))
                                {
                                    <option value="@slot.End">@slot.End</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="booking-recurring">
                                <span class="d-flex align-items-start gap-2">
                                    <input asp-for="IsRecurring" class="form-check-input mt-1" />
                                    <span>
                                        <strong>Make this a Recurring Weekly Booking</strong>
                                        <span class="d-block small muted">e.g. weekly badminton/swimming</span>
                                    </span>
                                </span>
                                <span class="badge-soft">Auto-reserve slots</span>
                            </label>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label text-uppercase small muted">Booking remarks / setup instructions (optional)</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="E.g., Require 4 extra chairs, tournament warm-up, birthday celebration..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="booking-step" data-step="2" hidden>
                    <h3 class="h6 mb-3">Equipment available with this facility</h3>
                    @if (!Model.Equipment.Any())
                    {
                        <p class="muted">No equipment inventory is linked to this facility.</p>
                    }
                    else
                    {
                        <div class="equipment-grid">
                            @for (var i = 0; i < Model.Equipment.Count; i++)
                            {
                                var item = Model.Equipment[i];
                                <label class="equipment-card">
                                    <input type="checkbox"
                                           name="SelectedEquipmentIds"
                                           value="@item.Id"
                                           data-name="@item.Name"
                                           data-daily-fee="@item.DailyFee.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           @(item.Quantity < 1 ? "disabled" : null) />
                                    <span>
                                        <strong>@item.Name</strong>
                                        <span class="d-block small muted">× @item.Quantity · @item.Condition</span>
                                        <span class="d-block small">MYR @item.DailyFee.ToString("N2")/day · full price</span>
                                    </span>
                                </label>
                            }
                        </div>
                        <p class="small muted mt-3 mb-0">Equipment is charged at full price (member discount applies to the facility fee only).</p>
                    }
                </div>

                <div class="booking-step" data-step="3" hidden>
                    <h3 class="h6 mb-1">Guests (optional, max @Model.MaxGuests)</h3>
                    <p class="muted small mb-3">Guest visitor passes are created with your booking — no separate guest registration page.</p>
                    @for (var i = 0; i < Model.Guests.Count; i++)
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-md-4"><input asp-for="Guests[i].FullName" class="form-control" placeholder="Full name" /></div>
                            <div class="col-md-4"><input asp-for="Guests[i].IdentificationNumber" class="form-control" placeholder="ID number" /></div>
                            <div class="col-md-4"><input asp-for="Guests[i].Phone" class="form-control" placeholder="Phone" /></div>
                        </div>
                    }
                </div>

                <div class="booking-step" data-step="4" hidden>
                    <h3 class="h6 mb-3">Review &amp; pay</h3>
                    <div class="review-box">
                        <div><span class="muted">Facility</span><strong>@Model.FacilityName</strong></div>
                        <div><span class="muted">Date</span><strong id="reviewDate">@Model.Date.ToString("dd MMM yyyy")</strong></div>
                        <div><span class="muted">Time</span><strong id="reviewTime">@(string.IsNullOrEmpty(Model.SlotStart) ? "—" : $"{Model.SlotStart} – {Model.SlotEnd}")</strong></div>
                        <div><span class="muted">Facility rate</span><strong>MYR @Model.HourlyRate.ToString("N2")/hr · @Model.DiscountPercent.ToString("N0")% member discount on facility only</strong></div>
                        <div>
                            <span class="muted">Booking mode</span>
                            <strong>@(Model.BookingMode == BookingMode.ApprovalRequired ? "Staff approval required before payment" : "Instant confirmation after payment")</strong>
                        </div>
                        <hr class="my-1 opacity-25" />
                        <div>
                            <span class="muted">Facility fee</span>
                            <strong id="reviewFacilityFee">—</strong>
                        </div>
                        <div id="reviewEquipmentBlock">
                            <span class="muted">Equipment (full price)</span>
                            <div id="reviewEquipmentLines" class="review-equipment-lines"></div>
                        </div>
                        <div class="review-total">
                            <span class="muted">Grand total</span>
                            <strong id="reviewGrandTotal">MYR 0.00</strong>
                        </div>
                    </div>
                    <p class="muted small mt-3 mb-0">Submitting holds the slot and continues to payment when an invoice is created. Member discount never applies to equipment rental.</p>
                </div>

                <div class="booking-modal__footer">
                    <button type="button" class="btn btn-link booking-modal__back" id="bookingBackBtn" hidden>Back</button>
                    <a class="btn btn-link text-decoration-none muted" asp-controller="Facilities" asp-action="Details" asp-route-id="@Model.FacilityId" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" id="bookingCancelLink">Cancel</a>
                    <button type="button" class="btn btn-primary" id="bookingNextBtn">Continue →</button>
                    <button type="submit" class="btn btn-primary" id="bookingSubmitBtn" hidden>Submit reservation</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
<script>
(() => {
  let step = 1;
  const total = 4;
  const hourlyRate = @Model.HourlyRate.ToString(System.Globalization.CultureInfo.InvariantCulture);
  const discountPercent = @Model.DiscountPercent.ToString(System.Globalization.CultureInfo.InvariantCulture);
  const steps = [...document.querySelectorAll('.booking-step')];
  const tabs = [...document.querySelectorAll('[data-step-tab]')];
  const nextBtn = document.getElementById('bookingNextBtn');
  const backBtn = document.getElementById('bookingBackBtn');
  const submitBtn = document.getElementById('bookingSubmitBtn');
  const cancelLink = document.getElementById('bookingCancelLink');
  const dateInput = document.querySelector('input[name="Date"]');
  const startSelect = document.getElementById('slotStartSelect');
  const endSelect = document.getElementById('slotEndSelect');
  const reviewDate = document.getElementById('reviewDate');
  const reviewTime = document.getElementById('reviewTime');
  const reviewFacilityFee = document.getElementById('reviewFacilityFee');
  const reviewEquipmentLines = document.getElementById('reviewEquipmentLines');
  const reviewGrandTotal = document.getElementById('reviewGrandTotal');
  const equipmentChecks = [...document.querySelectorAll('input[name="SelectedEquipmentIds"]')];

  const money = (n) => `MYR ${n.toFixed(2)}`;

  const parseTime = (value) => {
    if (!value) return null;
    const parts = value.split(':').map(Number);
    if (parts.length < 2 || parts.some((p) => Number.isNaN(p))) return null;
    return parts[0] + parts[1] / 60;
  };

  const billableHours = () => {
    const start = parseTime(startSelect?.value);
    const end = parseTime(endSelect?.value);
    if (start == null || end == null || end <= start) return 0;
    return end - start;
  };

  const billableDays = (hours) => Math.max(1, Math.ceil(hours / 24));

  const syncReview = () => {
    if (dateInput && reviewDate) {
      const d = new Date(dateInput.value);
      reviewDate.textContent = Number.isNaN(d.getTime())
        ? dateInput.value
        : d.toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });
    }
    if (reviewTime) {
      const start = startSelect?.value || '';
      const end = endSelect?.value || '';
      reviewTime.textContent = start && end ? `${start} – ${end}` : '—';
    }

    const hours = billableHours();
    const facilityBase = Math.round(hourlyRate * hours * 100) / 100;
    const facilityDiscount = Math.round(facilityBase * (discountPercent / 100) * 100) / 100;
    const facilityNet = Math.max(0, Math.round((facilityBase - facilityDiscount) * 100) / 100);
    const days = hours > 0 ? billableDays(hours) : 1;

    if (reviewFacilityFee) {
      if (hours <= 0) {
        reviewFacilityFee.textContent = 'Select a time slot';
      } else if (facilityDiscount > 0) {
        reviewFacilityFee.textContent = `${money(facilityNet)} (was ${money(facilityBase)}, −${discountPercent}% member)`;
      } else {
        reviewFacilityFee.textContent = money(facilityNet);
      }
    }

    let equipmentTotal = 0;
    const lines = [];
    equipmentChecks.filter((el) => el.checked && !el.disabled).forEach((el) => {
      const daily = Number(el.dataset.dailyFee || 0);
      const line = Math.round(daily * days * 100) / 100;
      equipmentTotal += line;
      lines.push(`<div class="review-equipment-line"><span>${el.dataset.name || 'Equipment'} × 1 · ${days} day${days === 1 ? '' : 's'}</span><strong>${money(line)}</strong></div>`);
    });

    if (reviewEquipmentLines) {
      reviewEquipmentLines.innerHTML = lines.length
        ? lines.join('')
        : '<div class="small muted">No equipment selected</div>';
    }

    if (reviewGrandTotal) {
      const grand = Math.round((facilityNet + equipmentTotal) * 100) / 100;
      reviewGrandTotal.textContent = hours > 0 ? money(grand) : '—';
    }
  };

  const showStep = (n) => {
    step = Math.min(total, Math.max(1, n));
    steps.forEach((el) => {
      const active = Number(el.dataset.step) === step;
      el.hidden = !active;
      el.classList.toggle('is-active', active);
    });
    tabs.forEach((tab) => {
      tab.classList.toggle('is-active', Number(tab.dataset.stepTab) === step);
    });
    backBtn.hidden = step === 1;
    cancelLink.hidden = step !== 1;
    nextBtn.hidden = step === total;
    submitBtn.hidden = step !== total;
    syncReview();
  };

  nextBtn?.addEventListener('click', () => {
    if (step === 1) {
      if (!dateInput?.value || !startSelect?.value || !endSelect?.value) {
        alert('Please choose a reservation date, start time and end time.');
        return;
      }
    }
    showStep(step + 1);
  });
  backBtn?.addEventListener('click', () => showStep(step - 1));
  tabs.forEach((tab) => tab.addEventListener('click', () => showStep(Number(tab.dataset.stepTab))));
  dateInput?.addEventListener('change', syncReview);
  startSelect?.addEventListener('change', syncReview);
  endSelect?.addEventListener('change', syncReview);
  equipmentChecks.forEach((el) => el.addEventListener('change', syncReview));
  showStep(1);
})();
</script>
}
