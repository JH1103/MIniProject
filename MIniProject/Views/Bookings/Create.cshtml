@model BookingCreateViewModel
@{
    ViewData["Title"] = "Book facility";
}

<section class="section">
    <div class="container" style="max-width:860px">
        <div class="section-head">
            <h2>Book @Model.FacilityName</h2>
            <p class="muted mb-0">
                @(Model.BookingMode == BookingMode.ApprovalRequired
                    ? "This facility requires staff approval before payment."
                    : "Instant confirmation after successful payment.")
                Rate: MYR @Model.HourlyRate.ToString("N2")/hr
            </p>
        </div>
        <form asp-action="Create" method="post" class="panel">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="FacilityId" />
            <input type="hidden" asp-for="FacilityName" />
            <input type="hidden" asp-for="BookingMode" />
            <input type="hidden" asp-for="HourlyRate" />
            <input type="hidden" asp-for="MaxGuests" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Start</label>
                    <select asp-for="SlotStart" class="form-select">
                        <option value="">Select</option>
                        @foreach (var slot in Model.AvailableSlots.Where(s => s.Available))
                        {
                            <option value="@slot.Start">@slot.Start</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">End</label>
                    <select asp-for="SlotEnd" class="form-select">
                        <option value="">Select</option>
                        @foreach (var slot in Model.AvailableSlots.Where(s => s.Available))
                        {
                            <option value="@slot.End">@slot.End</option>
                        }
                    </select>
                </div>
            </div>

            <h3 class="h5 mt-4">Guests (optional, max @Model.MaxGuests)</h3>
            @for (var i = 0; i < Model.Guests.Count; i++)
            {
                <div class="row g-2 mb-2">
                    <div class="col-md-4"><input asp-for="Guests[i].FullName" class="form-control" placeholder="Full name" /></div>
                    <div class="col-md-4"><input asp-for="Guests[i].IdentificationNumber" class="form-control" placeholder="ID number" /></div>
                    <div class="col-md-4"><input asp-for="Guests[i].Phone" class="form-control" placeholder="Phone" /></div>
                </div>
            }

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Submit reservation</button>
                <a class="btn btn-ghost" asp-controller="Facilities" asp-action="Details" asp-route-id="@Model.FacilityId">Cancel</a>
            </div>
        </form>
    </div>
</section>
