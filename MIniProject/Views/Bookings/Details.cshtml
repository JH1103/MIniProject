@model Booking
@{
    ViewData["Title"] = $"Booking #{Model.Id}";
}

<section class="section">
    <div class="container" style="max-width:860px">
        <div class="section-head">
            <h2>Booking #@Model.Id</h2>
            <p class="muted mb-0">@Model.Facility?.Name · @Model.StartUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") – @Model.EndUtc.ToLocalTime().ToString("HH:mm")</p>
        </div>
        <div class="panel">
            @{
                var chargedEquipment = Model.EquipmentRentals
                    .Where(r => r.Status is not (EquipmentRentalStatus.Cancelled or EquipmentRentalStatus.Inactive))
                    .ToList();
                var equipmentTotal = chargedEquipment.Sum(r => r.Fee);
                var facilityPortion = Math.Max(0, Model.Amount - equipmentTotal);
            }
            <div class="row g-3">
                <div class="col-md-4"><strong>Status</strong><div><span class="badge-soft">@Model.Status</span></div></div>
                <div class="col-md-4">
                    <strong>Amount</strong>
                    <div>MYR @Model.Amount.ToString("N2")</div>
                    @if (equipmentTotal > 0)
                    {
                        <div class="small muted mt-1">
                            Facility MYR @facilityPortion.ToString("N2")
                            + equipment MYR @equipmentTotal.ToString("N2")
                        </div>
                    }
                </div>
                <div class="col-md-4"><strong>Hold expires</strong><div>@(Model.PaymentHoldExpiresAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "—")</div></div>
            </div>
            <hr />
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h3 class="h6 mb-0">Equipment rented</h3>
                @if (User.IsInRole(AppRoles.Member) && Model.Status is BookingStatus.Pending or BookingStatus.AwaitingPayment or BookingStatus.Confirmed)
                {
                    <a class="small" asp-controller="EquipmentRentals" asp-action="Create">+ Rent equipment</a>
                }
            </div>
            @if (!Model.EquipmentRentals.Any())
            {
                <p class="muted mb-0">No equipment rented for this booking.</p>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var rental in Model.EquipmentRentals.OrderBy(r => r.InventoryItem?.Name))
                    {
                        <li>
                            <a asp-controller="EquipmentRentals" asp-action="Details" asp-route-id="@rental.Id">
                                @(rental.InventoryItem?.Name ?? "Equipment") × @rental.Quantity
                            </a>
                            · MYR @rental.Fee.ToString("N2")
                            <span class="small muted">(full price)</span>
                            ·
                            @{
                                var eqLabel = EquipmentRentalLifecycle.DisplayLabel(rental.Status);
                                var eqBadge = rental.Status is EquipmentRentalStatus.Rented
                                    or EquipmentRentalStatus.Active
                                    ? "badge-soft"
                                    : "badge-warn";
                            }
                            <span class="@eqBadge">@eqLabel</span>
                        </li>
                    }
                </ul>
            }
            @if (Model.Guests.Any())
            {
                <hr />
                <h3 class="h6">Registered guests</h3>
                <ul>
                    @foreach (var g in Model.Guests)
                    {
                        <li>@g.Guest?.FullName</li>
                    }
                </ul>
            }
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (Model.Invoice is not null && Model.Invoice.Status == InvoiceStatus.Unpaid)
                {
                    <a class="btn btn-primary" asp-controller="Payments" asp-action="Pay" asp-route-id="@Model.Invoice.Id">Pay now</a>
                }
                @if (User.IsInRole(AppRoles.Member) && Model.Status is BookingStatus.Pending or BookingStatus.AwaitingPayment or BookingStatus.Confirmed)
                {
                    <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@Model.Id">Update booking</a>
                    <form asp-action="Cancel" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="reason" value="Cancelled by user" />
                        <button class="btn btn-ghost" type="submit">Cancel booking</button>
                    </form>
                }
                else if (Model.Status is BookingStatus.Pending or BookingStatus.AwaitingPayment or BookingStatus.Confirmed)
                {
                    <form asp-action="Cancel" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="reason" value="Cancelled by clubhouse" />
                        <button class="btn btn-ghost" type="submit">Cancel booking</button>
                    </form>
                }
                @if (User.IsInRole(AppRoles.Administrator) && Model.Status == BookingStatus.Cancelled)
                {
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Hard-delete this cancelled booking?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-ghost admin-danger" type="submit">Delete booking</button>
                    </form>
                }
                <a class="btn btn-ghost" asp-controller="Member" asp-action="Dashboard">Back to dashboard</a>
            </div>
        </div>
    </div>
</section>
