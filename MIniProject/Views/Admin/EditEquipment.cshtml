@model EquipmentCatalogEntry
@{
    ViewData["Title"] = Model.Id == 0 ? "Add equipment" : "Edit equipment";
}

<section class="section">
    <div class="container" style="max-width:720px">
        <div class="section-head">
            <h2>@ViewData["Title"]</h2>
            <p class="muted mb-0">Club-wide equipment catalog. Facility inventory links pick from these items.</p>
        </div>
        <form asp-action="EditEquipment" method="post" class="panel">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4 form-check mt-4 pt-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional notes for staff"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <button class="btn btn-primary" type="submit">Save equipment</button>
                <a class="btn btn-ghost" asp-action="Index" asp-route-tab="facilities">Back</a>
            </div>
        </form>
        @if (Model.Id > 0)
        {
            <form asp-action="DeleteEquipment" method="post" class="mt-3" onsubmit="return confirm('Delete or deactivate this equipment catalog item?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-ghost admin-danger" type="submit">Delete equipment</button>
            </form>
        }
    </div>
</section>
