@model AdminMemberFormViewModel
@{
    ViewData["Title"] = "Create staff";
}

<section class="section">
    <div class="container" style="max-width:720px">
        <div class="section-head">
            <h2>Create staff</h2>
            <p class="muted mb-0">Register a staff account for clubhouse operations. Members self-register; admins create staff only.</p>
        </div>
        <form asp-action="CreateStaff" method="post" class="panel">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="IdentificationNumber" class="form-label"></label>
                    <input asp-for="IdentificationNumber" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Role</label>
                    <input class="form-control is-readonly" value="Staff" readonly tabindex="-1" />
                    <div class="small muted mt-1">Assigned the Staff role for check-in and operations.</div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Create staff</button>
                <a class="btn btn-ghost" asp-action="Index" asp-route-tab="membership">Back</a>
            </div>
        </form>
    </div>
</section>
