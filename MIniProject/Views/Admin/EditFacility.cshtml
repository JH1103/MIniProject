@model Facility
@{
    ViewData["Title"] = Model.Id == 0 ? "Add facility" : "Edit facility";
}

<section class="section">
    <div class="container" style="max-width:860px">
        <div class="section-head">
            <h2>@ViewData["Title"]</h2>
            <p class="muted mb-0">Update facility details, operating hours, booking rules and status.</p>
        </div>
        <form asp-action="EditFacility" method="post" class="panel">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label"></label>
                    <input asp-for="Category" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="ImageUrl" class="form-label"></label>
                    <input asp-for="ImageUrl" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Capacity" class="form-label"></label>
                    <input asp-for="Capacity" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="HourlyRate" class="form-label"></label>
                    <input asp-for="HourlyRate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="OpenTime" class="form-label"></label>
                    <input asp-for="OpenTime" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="CloseTime" class="form-label"></label>
                    <input asp-for="CloseTime" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="SlotDurationMinutes" class="form-label"></label>
                    <input asp-for="SlotDurationMinutes" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="PaymentHoldMinutes" class="form-label"></label>
                    <input asp-for="PaymentHoldMinutes" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="BookingMode" class="form-label"></label>
                    <select asp-for="BookingMode" class="form-select" asp-items="Html.GetEnumSelectList<BookingMode>()"></select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<FacilityStatus>()"></select>
                </div>
                <div class="col-md-3 form-check mt-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="mt-4">
                <button class="btn btn-primary" type="submit">Save facility</button>
                <a class="btn btn-ghost" asp-action="Index">Back</a>
            </div>
        </form>

        @if (Model.Id > 0)
        {
            <div class="panel mt-3">
                <h3 class="h5">Add inventory</h3>
                <form asp-action="AddInventory" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="facilityId" value="@Model.Id" />
                    <div class="col-md-6"><input class="form-control" name="name" placeholder="Item name" required /></div>
                    <div class="col-md-3"><input class="form-control" name="quantity" type="number" value="1" min="1" /></div>
                    <div class="col-md-3"><button class="btn btn-ghost w-100" type="submit">Add</button></div>
                </form>
                @if (Model.InventoryItems?.Any() == true)
                {
                    <ul class="mt-3 mb-0">
                        @foreach (var item in Model.InventoryItems)
                        {
                            <li>@item.Name × @item.Quantity (@item.Condition)</li>
                        }
                    </ul>
                }
            </div>

            <div class="panel mt-3">
                <h3 class="h5">Block out dates</h3>
                <form asp-action="BlockOut" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="facilityId" value="@Model.Id" />
                    <div class="col-md-4"><input class="form-control" type="datetime-local" name="start" required /></div>
                    <div class="col-md-4"><input class="form-control" type="datetime-local" name="end" required /></div>
                    <div class="col-md-4"><input class="form-control" name="reason" placeholder="Reason" value="Maintenance" /></div>
                    <div class="col-12"><button class="btn btn-ghost" type="submit">Save block-out</button></div>
                </form>
            </div>
        }
    </div>
</section>
