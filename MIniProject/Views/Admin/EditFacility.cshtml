@model Facility
@{
    ViewData["Title"] = Model.Id == 0 ? "Add facility" : "Edit facility";
}

<section class="section">
    <div class="container" style="max-width:860px">
        <div class="section-head">
            <h2>@ViewData["Title"]</h2>
            <p class="muted mb-0">Update facility details, operating hours, booking rules, inventory and status.</p>
        </div>
        <form asp-action="EditFacility" method="post" class="panel">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label"></label>
                    <input asp-for="Category" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="ImageUrl" class="form-label"></label>
                    <input asp-for="ImageUrl" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Capacity" class="form-label"></label>
                    <input asp-for="Capacity" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="HourlyRate" class="form-label"></label>
                    <input asp-for="HourlyRate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="OpenTime" class="form-label"></label>
                    <input asp-for="OpenTime" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="CloseTime" class="form-label"></label>
                    <input asp-for="CloseTime" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="SlotDurationMinutes" class="form-label"></label>
                    <input asp-for="SlotDurationMinutes" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="PaymentHoldMinutes" class="form-label"></label>
                    <input asp-for="PaymentHoldMinutes" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="BookingMode" class="form-label"></label>
                    <select asp-for="BookingMode" class="form-select" asp-items="Html.GetEnumSelectList<BookingMode>()"></select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<FacilityStatus>()"></select>
                </div>
                <div class="col-md-3 form-check mt-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <button class="btn btn-primary" type="submit">Save facility</button>
                <a class="btn btn-ghost" asp-action="Index" asp-route-tab="facilities">Back</a>
            </div>
        </form>
        @if (Model.Id > 0)
        {
            <form asp-action="DeleteFacility" method="post" class="mt-2" onsubmit="return confirm('Delete this facility? Facilities with upcoming bookings will be deactivated instead.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-ghost admin-danger" type="submit">Delete facility</button>
            </form>
        }

        @if (Model.Id > 0)
        {
            <div class="panel mt-3">
                <h3 class="h5">Inventory (CRUD)</h3>
                <form asp-action="AddInventory" method="post" class="row g-2 mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="facilityId" value="@Model.Id" />
                    <div class="col-md-4"><input class="form-control" name="name" placeholder="Item name" required /></div>
                    <div class="col-md-2"><input class="form-control" name="quantity" type="number" value="1" min="0" /></div>
                    <div class="col-md-3">
                        <select class="form-select" name="condition" asp-items="Html.GetEnumSelectList<InventoryCondition>()"></select>
                    </div>
                    <div class="col-md-3"><button class="btn btn-ghost w-100" type="submit">Add inventory</button></div>
                </form>

                @if (Model.InventoryItems?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Qty</th>
                                    <th>Condition</th>
                                    <th>Notes</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.InventoryItems.OrderBy(i => i.Name))
                            {
                                <tr>
                                    <td colspan="5" class="p-0">
                                        <form asp-action="UpdateInventory" method="post" class="row g-2 align-items-center p-2 m-0 border-bottom">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <div class="col-md-3">
                                                <input class="form-control form-control-sm" name="name" value="@item.Name" required />
                                            </div>
                                            <div class="col-md-2">
                                                <input class="form-control form-control-sm" name="quantity" type="number" min="0" value="@item.Quantity" />
                                            </div>
                                            <div class="col-md-2">
                                                <select class="form-select form-select-sm" name="condition">
                                                    @foreach (InventoryCondition c in Enum.GetValues(typeof(InventoryCondition)))
                                                    {
                                                        if (c == item.Condition)
                                                        {
                                                            <option value="@((int)c)" selected>@c</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@((int)c)">@c</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <input class="form-control form-control-sm" name="notes" value="@item.Notes" placeholder="Notes" />
                                            </div>
                                            <div class="col-md-2 text-end text-nowrap">
                                                <button class="btn btn-sm btn-ghost" type="submit">Save</button>
                                            </div>
                                        </form>
                                        <form asp-action="DeleteInventory" method="post" class="px-2 pb-2" onsubmit="return confirm('Delete this inventory item?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="btn btn-sm btn-ghost admin-danger" type="submit">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="muted mb-0">No inventory items yet.</p>
                }
            </div>

            <div class="panel mt-3">
                <h3 class="h5">Block out dates</h3>
                <form asp-action="BlockOut" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="facilityId" value="@Model.Id" />
                    <div class="col-md-4"><input class="form-control" type="datetime-local" name="start" required /></div>
                    <div class="col-md-4"><input class="form-control" type="datetime-local" name="end" required /></div>
                    <div class="col-md-4"><input class="form-control" name="reason" placeholder="Reason" value="Maintenance" /></div>
                    <div class="col-12"><button class="btn btn-ghost" type="submit">Save block-out</button></div>
                </form>
            </div>
        }
    </div>
</section>
