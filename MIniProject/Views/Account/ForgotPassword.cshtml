@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<section class="auth-shell">
    <div class="auth-card">
        <h1 class="h3 mb-1">Forgot password</h1>
        <p class="muted mb-4">Enter the email on your member account. We’ll send a one-time code and a reset link.</p>
        <form asp-action="ForgotPassword" method="post" novalidate>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 mb-3" role="alert">
                    <div asp-validation-summary="All" class="mb-0"></div>
                </div>
            }
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger d-block mt-1"></span>
            </div>
            <button class="btn btn-primary w-100" type="submit">Send reset email</button>
        </form>
        <div class="mt-3 small">
            <a asp-action="Login">Back to sign in</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
