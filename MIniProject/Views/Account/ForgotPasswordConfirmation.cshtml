@{
    ViewData["Title"] = "Check your email";
}

<section class="auth-shell">
    <div class="auth-card">
        <h1 class="h3 mb-1">Check your email</h1>
        <p class="muted mb-3">
            We sent a one-time code (OTP) and a password reset link to your member email.
            The OTP expires soon — use it or the link to set a new password.
        </p>
        <p class="mb-4">
            <a class="btn btn-primary" asp-action="ResetPassword">Enter OTP / set new password</a>
        </p>
        <div class="small">
            <a asp-action="ForgotPassword">Resend email</a> ·
            <a asp-action="Login">Back to sign in</a>
        </div>
    </div>
</section>
