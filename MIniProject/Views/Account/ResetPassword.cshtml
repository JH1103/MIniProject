@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    var viaLink = Model.HasLinkToken;
}

<section class="auth-shell">
    <div class="auth-card">
        <h1 class="h3 mb-1">Choose a new password</h1>
        <p class="muted mb-4">
            @(viaLink
                ? "Your reset link was recognised. Enter and confirm your new password below."
                : "Enter your email, the 6-digit OTP from your email, then your new password twice.")
        </p>
        <form asp-action="ResetPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                @if (viaLink)
                {
                    <input asp-for="Email" class="form-control" autocomplete="username" readonly />
                }
                else
                {
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                }
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            @if (!viaLink)
            {
                <div class="mb-3">
                    <label asp-for="Otp" class="form-label"></label>
                    <input asp-for="Otp" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="6-digit code" />
                    <div class="form-text">Codes expire after a short time. Request a new one if yours has expired.</div>
                    <span asp-validation-for="Otp" class="text-danger"></span>
                </div>
            }

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="password-field">
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            data-password-toggle
                            aria-label="Show password"
                            aria-pressed="false"
                            title="Show password">
                        <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                            <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                        </svg>
                        <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                            <path d="M3 3l18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            <path d="M10.6 10.6a2.5 2.5 0 0 0 3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            <path d="M9.9 5.2A10.4 10.4 0 0 1 12 5c6.5 0 10 7 10 7a17.4 17.4 0 0 1-4.1 4.7M6.1 6.1A17.5 17.5 0 0 0 2 12s3.5 7 10 7a10.3 10.3 0 0 0 4.1-.9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
                <div class="form-text">At least 8 characters, with uppercase, lowercase and a number.</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="password-field">
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            data-password-toggle
                            aria-label="Show confirm password"
                            aria-pressed="false"
                            title="Show confirm password">
                        <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
                            <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
                        </svg>
                        <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                            <path d="M3 3l18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            <path d="M10.6 10.6a2.5 2.5 0 0 0 3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            <path d="M9.9 5.2A10.4 10.4 0 0 1 12 5c6.5 0 10 7 10 7a17.4 17.4 0 0 1-4.1 4.7M6.1 6.1A17.5 17.5 0 0 0 2 12s3.5 7 10 7a10.3 10.3 0 0 0 4.1-.9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button class="btn btn-primary w-100" type="submit">Save new password</button>
        </form>
        <div class="mt-3 small">
            <a asp-action="ForgotPassword">Request a new code</a> ·
            <a asp-action="Login">Back to sign in</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
