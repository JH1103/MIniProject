@model List<Facility>
@{
    ViewData["Title"] = "Home";
    var welcomeName = ViewBag.WelcomeName as string;
    var welcomeRole = ViewBag.WelcomeRole as string;
    var showWelcome = !string.IsNullOrWhiteSpace(welcomeName);
    var isStaffWelcome = showWelcome && welcomeRole == AppRoles.Staff;
}

<section class="hero">
    <div class="container hero__content">
        @if (showWelcome)
        {
            <span class="hero__eyebrow">@(isStaffWelcome ? "Staff portal" : "Member home")</span>
            <h1>Welcome, @welcomeName</h1>
            @if (isStaffWelcome)
            {
                <p>Jump into today’s operations — check-ins, membership lookups and the staff dashboard.</p>
                <div class="hero__actions">
                    <a class="btn btn-primary" asp-controller="Staff" asp-action="CheckIn">Staff operations</a>
                    <a class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.35)" asp-controller="Staff" asp-action="Index">Staff dashboard</a>
                </div>
            }
            else
            {
                <p>Book facilities, manage your membership and pick up where you left off.</p>
                <div class="hero__actions">
                    <a class="btn btn-primary" asp-controller="Facilities" asp-action="Index">Browse facilities</a>
                    <a class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.35)" asp-controller="Member" asp-action="Dashboard">My Dashboard</a>
                </div>
            }
        }
        else
        {
            <span class="hero__eyebrow">Kota Kemuning · Shah Alam</span>
            <h1>Kota Permai Golf &amp; Country Club</h1>
            <p>Reserve badminton, tennis, squash, pickleball, pools, gym, driving range bays and banquet rooms online — inspired by Kota Permai’s real club facilities.</p>
            <div class="hero__actions">
                <a class="btn btn-primary" asp-controller="Facilities" asp-action="Index">Browse facilities</a>
                <a class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.35)" asp-controller="Account" asp-action="Register">Become a member</a>
            </div>
        }
    </div>
</section>

@* Staff do not browse the public facilities catalogue; keep featured tiles for guests and members. *@
@if (!isStaffWelcome)
{
    <section class="section">
        <div class="container">
            <div class="section-head">
                <h2>Featured facilities</h2>
                <p class="muted mb-0">Sports courts, Olympic lap pool, gym, driving range and Permai Ballroom — ready to reserve online.</p>
            </div>
            <div class="facility-grid">
                @foreach (var facility in Model)
                {
                    <a class="facility-tile" asp-controller="Facilities" asp-action="Details" asp-route-id="@facility.Id">
                        <img src="@(facility.ImageUrl ?? "/images/facility-ballroom.jpg")" alt="@facility.Name" />
                        <div class="facility-tile__body">
                            <h3 class="h5 mb-2">@facility.Name</h3>
                            <div class="facility-tile__meta">
                                <span>@facility.Category</span>
                                <span>@(facility.HourlyRate == 0 ? "Member access" : $"MYR {facility.HourlyRate:N2}/hr")</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}
