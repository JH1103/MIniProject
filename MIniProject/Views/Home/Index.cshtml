@model List<Facility>
@{
    ViewData["Title"] = "Home";
    var announcements = ViewBag.Announcements as List<Announcement> ?? new();
}

<section class="hero">
    <div class="container hero__content">
        <span class="hero__eyebrow">Kota Kemuning · Shah Alam</span>
        <h1>Kota Permai Golf &amp; Country Club</h1>
        <p>Reserve badminton, tennis, squash, pickleball, pools, gym, driving range bays and banquet rooms online — inspired by Kota Permai’s real club facilities.</p>
        <div class="hero__actions">
            <a class="btn btn-primary" asp-controller="Facilities" asp-action="Index">Browse facilities</a>
            <a class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,.35)" asp-controller="Account" asp-action="Register">Become a member</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <h2>Featured facilities</h2>
            <p class="muted mb-0">Sports courts, Olympic lap pool, gym, driving range and Permai Ballroom — ready to reserve online.</p>
        </div>
        <div class="facility-grid">
            @foreach (var facility in Model)
            {
                <a class="facility-tile" asp-controller="Facilities" asp-action="Details" asp-route-id="@facility.Id">
                    <img src="@(facility.ImageUrl ?? "/images/facility-ballroom.jpg")" alt="@facility.Name" />
                    <div class="facility-tile__body">
                        <h3 class="h5 mb-2">@facility.Name</h3>
                        <div class="facility-tile__meta">
                            <span>@facility.Category</span>
                            <span>@(facility.HourlyRate == 0 ? "Member access" : $"MYR {facility.HourlyRate:0.00}/hr")</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

@if (announcements.Count > 0)
{
    <section class="section" style="padding-top:0">
        <div class="container">
            <div class="section-head">
                <h2>Announcements</h2>
                <p class="muted mb-0">Club notices and operating updates.</p>
            </div>
            <div class="row g-3">
                @foreach (var item in announcements)
                {
                    <div class="col-md-6">
                        <div class="panel">
                            <h3 class="h5">@item.Title</h3>
                            <p class="muted mb-0">@item.Body</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
