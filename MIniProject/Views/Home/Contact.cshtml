@{
    ViewData["Title"] = "Contact & Announcements";
    var announcements = ViewBag.Announcements as List<Announcement> ?? new();
}

<section class="section">
    <div class="container">
        <div class="section-head">
            <h2>Contact &amp; announcements</h2>
            <p class="muted mb-0">Reach Kota Permai Golf &amp; Country Club or review current notices.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="panel">
                    <h3 class="h5">Kota Permai Golf &amp; Country Club</h3>
                    <p class="mb-2">No. 1, Jalan 31/100A, Kota Kemuning, Section 31,<br />40460 Shah Alam, Selangor Darul Ehsan, Malaysia</p>
                    <p class="mb-2">Office / Sports: +603 5122 3700</p>
                    <p class="mb-2">Website: <a href="https://www.kotapermai.com.my/" target="_blank" rel="noopener">kotapermai.com.my</a></p>
                    <p class="mb-0">Email: hello@kotapermai.local</p>
                </div>
            </div>
            <div class="col-lg-7">
                @foreach (var item in announcements)
                {
                    <div class="panel mb-3">
                        <div class="d-flex justify-content-between gap-3">
                            <h3 class="h5 mb-2">@item.Title</h3>
                            <span class="badge-soft">@item.PublishedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                        </div>
                        <p class="muted mb-0">@item.Body</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
