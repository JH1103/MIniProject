@{
    ViewData["Title"] = "Privacy";
}

<section class="section">
    <div class="container" style="max-width:760px">
        <div class="section-head">
            <h2>Privacy notice</h2>
            <p class="muted">Personal data is handled in line with Malaysia's Personal Data Protection Act (PDPA) 2010.</p>
        </div>
        <div class="panel">
            <p>We collect member and guest details to manage bookings, visitor access, payments and clubhouse security.</p>
            <p>Passwords are hashed. Card details are processed only by the payment gateway and are not stored by this application.</p>
            <p class="mb-0">By registering, you consent to processing of your personal data for clubhouse operations. Contact the administrator to request corrections or account closure.</p>
        </div>
    </div>
</section>
