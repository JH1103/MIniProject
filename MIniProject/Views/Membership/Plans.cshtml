@model List<MembershipPlan>
@{
    ViewData["Title"] = "Membership plans";
    var plans = Model.OrderBy(p => p.AnnualFee).ToList();
    var changeMode = ViewBag.ChangeMode as bool? == true;
    var currentSub = ViewBag.CurrentSubscription as Subscription;
    var currentPlanId = currentSub?.MembershipPlanId;
    var currentPlanName = currentSub?.MembershipPlan?.Name;

    string TierClass(int index) => index switch
    {
        1 => "is-mid",
        2 => "is-top",
        _ => "is-base"
    };
    string PriorityLabel(MembershipPlan plan) => plan.DiscountPercent switch
    {
        >= 20 => "Guaranteed fast-track",
        >= 10 => "Standard priority",
        _ => "—"
    };
    string DiscountLabel(MembershipPlan plan) => plan.DiscountPercent <= 0
        ? "Standard rate"
        : $"{plan.DiscountPercent:N0}% off";
}

<section class="section">
    <div class="container">
        <div class="section-head">
            @if (changeMode)
            {
                <h2>Change membership plan</h2>
                <p class="muted mb-0">
                    @if (!string.IsNullOrEmpty(currentPlanName))
                    {
                        <text>Your current plan is <strong>@currentPlanName</strong>. Compare options below and switch when you are ready.</text>
                    }
                    else
                    {
                        <text>Choose a new membership tier below.</text>
                    }
                </p>
                <a class="small" asp-action="Manage">← Back to manage membership</a>
            }
            else
            {
                <h2>Membership plans</h2>
                <p class="muted mb-0">Choose a tier for advance booking limits, guest allowances and facility discounts.</p>
            }
        </div>

        <div class="row g-4 mb-5">
            @foreach (var plan in plans)
            {
                var isCurrent = currentPlanId == plan.Id;
                <div class="col-md-4">
                    <div class="panel h-100 @(isCurrent ? "plan-card--current" : null)">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                            <h3 class="h4 mb-0">@plan.Name</h3>
                            @if (isCurrent)
                            {
                                <span class="badge-soft">Current plan</span>
                            }
                        </div>
                        <p class="display mb-2" style="font-size:2rem">MYR @plan.AnnualFee.ToString("N2")</p>
                        <p class="muted">@plan.Description</p>
                        <ul class="mb-4">
                            <li>Book up to @plan.AdvanceBookingDays days ahead</li>
                            <li>Up to @plan.MaxGuestsPerBooking guests per booking</li>
                            <li>@plan.DiscountPercent% facility discount</li>
                        </ul>
                        @if (isCurrent)
                        {
                            <button class="btn btn-current-plan" type="button" disabled>Current plan</button>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-primary" asp-action="Subscribe" asp-route-planId="@plan.Id">
                                @(changeMode || currentPlanId is not null
                                    ? (plan.AnnualFee > (currentSub?.MembershipPlan?.AnnualFee ?? 0) ? "Upgrade to this plan" : "Switch to this plan")
                                    : "Subscribe")
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register to join</a>
                        }
                    </div>
                </div>
            }
        </div>

        @if (plans.Count >= 2)
        {
            <div class="plan-compare panel">
                <div class="plan-compare__head">
                    <div>
                        <h3 class="h4 mb-1">Membership privileges comparison</h3>
                        <p class="muted mb-0">Side-by-side features so you can pick the plan that fits your household.</p>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="plan-compare__table">
                        <thead>
                            <tr>
                                <th scope="col">Privilege / feature</th>
                                @for (var i = 0; i < plans.Count; i++)
                                {
                                    <th scope="col" class="@TierClass(i)">
                                        @plans[i].Name
                                        @if (currentPlanId == plans[i].Id)
                                        {
                                            <span class="badge-soft ms-1">Current</span>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Annual fee</th>
                                @for (var i = 0; i < plans.Count; i++)
                                {
                                    <td class="@TierClass(i)">MYR @plans[i].AnnualFee.ToString("N0")</td>
                                }
                            </tr>
                            <tr>
                                <th scope="row">Advance booking window</th>
                                @for (var i = 0; i < plans.Count; i++)
                                {
                                    <td class="@TierClass(i)">@plans[i].AdvanceBookingDays days</td>
                                }
                            </tr>
                            <tr>
                                <th scope="row">Facility rental discount</th>
                                @for (var i = 0; i < plans.Count; i++)
                                {
                                    <td class="@TierClass(i)">@DiscountLabel(plans[i])</td>
                                }
                            </tr>
                            <tr>
                                <th scope="row">Guests per booking</th>
                                @for (var i = 0; i < plans.Count; i++)
                                {
                                    <td class="@TierClass(i)">@plans[i].MaxGuestsPerBooking guests</td>
                                }
                            </tr>
                            <tr>
                                <th scope="row">Priority function hall approval</th>
                                @for (var i = 0; i < plans.Count; i++)
                                {
                                    <td class="@TierClass(i)">@PriorityLabel(plans[i])</td>
                                }
                            </tr>
                            <tr>
                                <th scope="row">15-minute payment hold lock</th>
                                @for (var i = 0; i < plans.Count; i++)
                                {
                                    <td class="@TierClass(i) is-included">Included</td>
                                }
                            </tr>
                            <tr>
                                <th scope="row">Digital membership QR card</th>
                                @for (var i = 0; i < plans.Count; i++)
                                {
                                    <td class="@TierClass(i) is-included">Included</td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>
